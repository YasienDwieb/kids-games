default_platform(:android)

# fastlane supply uploads listing text, images AND changelogs inside one
# per-version-code loop (supply/uploader.rb#perform_upload_meta). With no binary
# upload it has no version code and dies with "Could not find release for version
# code ''". So every listing lane must target an EXISTING release: a version_code
# that lives on the given track. Use the `tracks` lane to look these up.
def require_version_code(options)
  vc = options[:version_code] || ENV["ANDROID_VERSION_CODE"]
  if vc.to_s.empty?
    UI.user_error!("version_code required — pass version_code:<code> track:<track> " \
                   "(an existing release). Run `fastlane tracks` to list them.")
  end
  vc.to_i
end

def android_track(options)
  options[:track] || ENV["ANDROID_TRACK"] || "production"
end

platform :android do
  desc "List Play tracks and their releases (version codes) — read-only."
  lane :tracks do
    key = CredentialsManager::AppfileConfig.try_fetch_value(:json_key_file)
    # fastlane chdir's into fastlane/ when running a lane, so the repo-root-relative
    # key path needs re-resolving (basename works since cwd is fastlane/).
    key = [key, File.basename(key.to_s), File.join("..", key.to_s)].find { |p| p && File.exist?(p) } || key
    pkg = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
    require_relative "play_api"
    PlayApi.new(key, pkg).each_track do |track, releases|
      rels = releases.map { |r| "[#{r[:status]}] vc=#{r[:version_codes].join(',')} name=#{r[:name].inspect}" }
      UI.message("track=#{track.inspect}: #{rels.empty? ? '(no releases)' : rels.join(' | ')}")
    end
  end

  desc "Validate listing text + images + changelogs against the Play API (no changes)."
  desc "Requires version_code: of an existing release on track: (default production)."
  lane :validate do |options|
    upload_to_play_store(
      validate_only: true,
      track: android_track(options),
      version_code: require_version_code(options),
      skip_upload_apk: true,
      skip_upload_aab: true
    )
  end

  desc "Upload listing text + images for an existing release (no binary, no changelogs)."
  desc "Requires version_code: of an existing release on track: (default production)."
  lane :metadata do |options|
    upload_to_play_store(
      track: android_track(options),
      version_code: require_version_code(options),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      # Skip images whose sha256 already matches Play; otherwise every release
      # re-uploads (and lists as "changed") the icon, graphic and all screenshots.
      sync_image_upload: true
    )
  end

  desc "Push only release notes for an existing release."
  desc "Requires version_code: of an existing release on track: (default production)."
  lane :changelog do |options|
    upload_to_play_store(
      track: android_track(options),
      version_code: require_version_code(options),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  end

  desc "Promote an existing release to another track — no rebuild, no new version code."
  desc "fastlane promote version_code:<vc> [track:internal] [to:production] [status:draft]"
  lane :promote do |options|
    from = options[:track] || "internal"
    to   = options[:to]    || "production"
    upload_to_play_store(
      track: from,
      track_promote_to: to,
      # draft by default: the release lands on the target track but stays behind
      # "Start rollout" in the Console. Pass status:completed to go live directly.
      track_promote_release_status: options[:status] || "draft",
      version_code: require_version_code(options),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Start rollout of an existing draft release — this is what makes it live."
  desc "fastlane rollout version_code:<vc> [track:production] [percent:0.2]"
  lane :rollout do |options|
    # `rollout` MUST always be passed. With no binary upload, supply only touches
    # an existing release if track_promote_to or rollout is set
    # (supply/uploader.rb#perform_upload) — release_status alone is never read on
    # that path, so a nil rollout commits an empty edit and reports success while
    # leaving the release a draft.
    percent = options[:percent] ? options[:percent].to_f : 1.0
    UI.user_error!("percent must be > 0 and <= 1.0 (got #{percent})") unless percent > 0 && percent <= 1.0
    upload_to_play_store(
      track: android_track(options),
      version_code: require_version_code(options),
      # A staged rollout is 'inProgress' + a fraction; 1.0 means full release.
      release_status: percent < 1.0 ? "inProgress" : "completed",
      rollout: percent.to_s,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Pull current listing from Play Console into fastlane/metadata."
  lane :pull do
    download_from_play_store
  end
end

# iOS ships through EAS (build/submit/metadata), and `eas metadata:push` never
# uploads screenshots. This lane covers only that gap.
platform :ios do
  desc "Replace the App Store screenshots (en-US + ar-SA, iPhone 6.9\" + iPad 13\") on the editable version."
  desc "No text, binary or submission. fastlane ios screenshots [app_version:1.3.0]"
  lane :screenshots do |options|
    # Lanes run from fastlane/; paths below are repo-root relative.
    root = File.expand_path("..", Dir.pwd)
    ios = JSON.parse(File.read(File.join(root, "eas.json"))).dig("submit", "production", "ios")
    key = app_store_connect_api_key(
      key_id: ios["ascApiKeyId"],
      issuer_id: ios["ascApiKeyIssuerId"],
      key_filepath: File.join(root, ios["ascApiKeyPath"])
    )
    # Device slot comes from each image's size (deliver/app_screenshot.rb).
    shots = File.join(root, "fastlane/metadata/ios/screenshots")
    deliver(
      api_key: key,
      app_identifier: CredentialsManager::AppfileConfig.try_fetch_value(:package_name),
      app_version: options[:app_version],
      platform: "ios",
      # deliver validates locale dir names under metadata_path even with skip_metadata;
      # the default ./fastlane/metadata holds android/ and ios/, which fail that check.
      metadata_path: shots,
      screenshots_path: shots,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
